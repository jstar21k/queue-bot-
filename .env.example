# Telegram Queue Bot - Environment Variables Example
# Copy this file to .env and fill in your values

# ============ REQUIRED ============

# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_bot_token_here

# MongoDB Connection String
# Format: mongodb://username:password@host:port/?authSource=admin
# For MongoDB Atlas, prefer the exact mongodb+srv URI from the Atlas "Connect" dialog
# Example: mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority&appName=queue-bot
# For Railway MongoDB: get from Railway connection variables
MONGO_URI=mongodb://localhost:27017

# Channel IDs (must be numeric IDs, not usernames)
# Get these by forwarding a message from the channel to @userinfobot
INTAKE_CHANNEL_ID=-1001234567890
STORAGE_CHANNEL_ID=-1000987654321

# Admin Telegram User ID
# Get this by messaging @userinfobot
ADMIN_ID=123456789

# ============ OPTIONAL ============

# Delete intake messages after moving to storage (default: false)
DELETE_INTAKE_MESSAGES=false

# Timeout in hours before alerting admin (default: 24)
TIMEOUT_HOURS=24

# MongoDB database name (default: queue_bot)
DB_NAME=queue_bot
